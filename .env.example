# Copy this file to .env and fill in your own values.
# Never commit .env, and never paste its contents anywhere public.

GEMINI_API_KEY=your-new-api-key-here

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=itegeko

# Optional overrides:
# GEMINI_MODEL=gemini-3.5-flash
# FLASK_SECRET_KEY=generate-a-random-string-here
# FLASK_DEBUG=false

# Pro plan payments (Flutterwave -- supports card + MTN/Airtel Mobile Money).
# Get this from your Flutterwave dashboard > Settings > API Keys.
# Leave unset and the app runs fine -- the Upgrade button just shows
# "not configured yet" until you add it.
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxx

# RWF amount charged for Pro (~$10/month at time of writing -- check the
# current USD/RWF rate and adjust).
# PRO_PRICE_RWF=13500
# PRO_PRICE_LABEL=$10

# Usage limits (all optional -- these are the actual built-in defaults):
# GUEST_POPUP_AFTER=3
# GUEST_MESSAGE_LIMIT=10
# FREE_PLAN_DAILY_LIMIT=10
# FREE_PLAN_WEEKLY_LIMIT=60
# PRO_PLAN_DAILY_LIMIT=500
# PRO_PLAN_WEEKLY_LIMIT=3500

# Password reset & email verification (optional -- leave unset and both
# features quietly no-op: reset shows "email not configured yet" and new
# accounts just stay unverified with no error). Any standard SMTP provider
# works -- Gmail App Passwords, SendGrid, Mailgun, Zoho, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password-or-app-password
# SMTP_FROM=noreply@itegeko.rw
