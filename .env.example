# Copy this file to .env and fill in your own values.
# Never commit .env, and never paste its contents anywhere public.

GEMINI_API_KEY=your-new-api-key-here

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=itegeko

# Optional overrides:
# GEMINI_MODEL=gemini-3.5-flash
# FLASK_SECRET_KEY=generate-a-random-string-here
# FLASK_DEBUG=false

# Pro plan payments (Flutterwave -- supports card + MTN/Airtel Mobile Money).
# Get this from your Flutterwave dashboard > Settings > API Keys.
# Leave unset and the app runs fine -- the Upgrade button just shows
# "not configured yet" until you add it.
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxx

# RWF amount charged for Pro (~$10/month at time of writing -- check the
# current USD/RWF rate and adjust).
# PRO_PRICE_RWF=13500
# PRO_PRICE_LABEL=$10

# Usage limits (all optional, sensible defaults are built in):
# GUEST_POPUP_AFTER=3
# GUEST_MESSAGE_LIMIT=15
# FREE_PLAN_DAILY_LIMIT=30
# PRO_PLAN_DAILY_LIMIT=500
